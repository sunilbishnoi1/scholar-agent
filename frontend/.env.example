# Scholar Agent Frontend Environment Variables

# Backend API URL (Render or local)
# Production: https://scholar-backend.onrender.com (or your actual Render backend URL)
# Local: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# WebSocket URL (for real-time updates)
# Production: wss://scholar-backend.onrender.com (or your actual Render backend URL)
# Local: ws://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000

# ============================================
# Neon Auth & Data API (Required for Auth)
# ============================================

# Enable Neon Auth (set to 'true' to use Neon Auth, 'false' for legacy auth)
VITE_USE_NEON_AUTH=true

# Neon Auth URL (enable in Neon Console → Data API → Use Neon Auth)
# Format: https://ep-xxx.neonauth.c-2.us-east-2.aws.neon.build/dbname/auth
VITE_NEON_AUTH_URL=

# Neon Data API URL (enable in Neon Console → Data API)
# Format: https://ep-xxx.apirest.c-2.us-east-2.aws.neon.build/dbname/rest/v1
VITE_NEON_DATA_API_URL=
